{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv --unstable-cron server.ts",
    "check": "deno check server.ts deno/collector.ts deno/store.ts && deno test --allow-read --unstable-kv deno/",
    "collect": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv scripts/collect-deno.ts"
  },
  "fmt": {
    "lineWidth": 110,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "deploy": {
    "org": "xmldom",
    "app": "npm-version-dashboard",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "server.ts"
    }
  }
}
